# MongoDB Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/foodies?retryWrites=true&w=majority"

# OPTIONAL: Voyage AI Configuration (required for Vector Search)
# VOYAGE_API_KEY=your_voyage_api_key

# Required: shared secret for write/delete endpoints (POST/PATCH/DELETE on
# /api/recipes). Send it as the "X-API-Key" header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_api_key

# Server Configuration
PORT=3011

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
